DATABASE_URL=postgres://postgres:postgres@localhost:5432/hellocouncil
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=hellocouncil

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_INFERENCE_API_KEY=your_livekit_inference_key
LIVEKIT_AGENT_NAME=hellocouncil-agent
LIVEKIT_STT_MODEL=deepgram/nova-3
LIVEKIT_LLM_MODEL=openai/gpt-4.1-mini
LIVEKIT_TTS_MODEL=cartesia/sonic-3
LIVEKIT_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_account_auth_token
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_FROM_NUMBER=+15551234567
PUBLIC_BASE_URL=https://your-ngrok-or-deployed-host.example

# When true, due follow-up steps place real Twilio calls autonomously.
# Requires the TWILIO_* variables and PUBLIC_BASE_URL above to be configured.
AUTO_OUTBOUND_CALLS=true

